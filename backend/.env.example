# Copy this file to .env and fill in your values. Never commit .env.

PORT=3000
SOURCE_URL=https://ipo.ug.edu.gh/study-abroad/exchange-opportunities
DATABASE_PATH=data/opnest.sqlite

# How often to check the page (cron syntax). Every 30 minutes.
SYNC_CRON=*/30 * * * *
SYNC_ON_STARTUP=true
# On the first run, email the listings already on the page too (true/false).
NOTIFY_EXISTING_ON_FIRST_SYNC=false

# Email (Brevo SMTP relay). Port 2525 avoids hosts that block 587, such as Render's free plan.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=xsmtpsib-...
# The "from" address. It must be a verified sender in Brevo (Senders, Domains & Dedicated IPs > Senders).
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=OpNest
# Optional: defaults to MAIL_FROM. Separate several recipients with commas.
MAIL_TO=

# Secret for POST /sync and POST /notifications/test (send it as x-admin-token).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me
